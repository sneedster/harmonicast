<?xml version="1.0"?>
<Container version="2">
  <Name>Resonance</Name>
  <Repository>mjstrong/resonance:latest</Repository>
  <Registry>https://hub.docker.com/r/mjstrong/resonance</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/sneedster/resonance</Support>
  <Project>https://github.com/sneedster/resonance</Project>
  <Overview>Self-hosted collaborative music jukebox for Subsonic-compatible servers. Configure Google OAuth before first sign-in.</Overview>
  <Category>MediaApp:Music</Category>
  <WebUI>http://[IP]:[PORT:3001]</WebUI>
  <Icon>https://raw.githubusercontent.com/sneedster/resonance/main/android/app/src/main/res/drawable/ic_jukebox.xml</Icon>
  <ExtraParams>--security-opt no-new-privileges:true</ExtraParams>
  <Config Name="Web UI port" Target="3001" Default="3001" Mode="tcp" Description="Resonance web application" Type="Port" Display="always" Required="true" Mask="false">3001</Config>
  <Config Name="Application data" Target="/app/data" Default="/mnt/user/appdata/resonance" Mode="rw" Description="Persistent SQLite database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/resonance</Config>
  <Config Name="Public URL" Target="PUBLIC_URL" Default="http://[IP]:[PORT:3001]" Mode="" Description="Must match the Google OAuth redirect URI, without a trailing slash" Type="Variable" Display="always" Required="true" Mask="false">http://[IP]:[PORT:3001]</Config>
  <Config Name="Google client ID" Target="GOOGLE_CLIENT_ID" Default="" Mode="" Description="Google OAuth web client ID" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Google client secret" Target="GOOGLE_CLIENT_SECRET" Default="" Mode="" Description="Google OAuth web client secret" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Admin email" Target="ADMIN_EMAIL" Default="" Mode="" Description="Google account allowed to create the first host user" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Music server URL" Target="MUSIC_SERVER_URL" Default="" Mode="" Description="Optional Subsonic-compatible server URL" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Music server user" Target="MUSIC_SERVER_USER" Default="" Mode="" Description="Optional Subsonic username" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Music server password" Target="MUSIC_SERVER_PASSWORD" Default="" Mode="" Description="Optional Subsonic password" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Music server name" Target="MUSIC_SERVER_NAME" Default="" Mode="" Description="Optional display name" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
