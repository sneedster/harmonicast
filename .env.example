# ── Server ────────────────────────────────────────────────────────────

# Docker host port. Leave at 3001 unless another service already uses it.
RESONANCE_PORT=3001

# Published Docker image tag. Pin a release tag in production.
RESONANCE_IMAGE_TAG=latest

# The public URL where users access Resonance (no trailing slash).
# Example: https://resonance.mydomain.com or http://192.168.1.50:3001
PUBLIC_URL=http://localhost:3001

# Optional stable Plex client identifier. When omitted, Resonance generates one
# and persists it in the SQLite data volume. Do not reuse another Plex app's ID.
# PLEX_CLIENT_IDENTIFIER=

# Plex source configuration. Use the server API root; a normal Plex Web URL
# ending in /web is also accepted. Generate the token by completing Plex
# sign-in; keep it only in this deployment environment, never in source code.
# PLEX_SERVER_URL=http://192.168.1.50:32400
# PLEX_SERVER_TOKEN=
# PLEX_LIBRARY_KEY=

# The email address of the admin/owner. This user is always the host
# and is the only one who can create the first account. Plex library sharing
# controls guest access after setup.
ADMIN_EMAIL=your-plex-email@example.com

# Pre-configure your Navidrome/Subsonic server so you don't have to
# type the address every time.
MUSIC_SERVER_URL=http://192.168.1.50:4533
MUSIC_SERVER_USER=admin
MUSIC_SERVER_PASSWORD=changeme
MUSIC_SERVER_NAME=My Music
