# ── Server ────────────────────────────────────────────────────────────

# Docker host port. Leave at 3001 unless another service already uses it.
RESONANCE_PORT=3001

# Published Docker image tag. Pin a tested release in production.
RESONANCE_IMAGE_TAG=1.0.7

# The public URL where users access Resonance (no trailing slash).
# Example: https://resonance.mydomain.com or http://192.168.1.50:3001
PUBLIC_URL=http://localhost:3001

# Optional stable Plex client identifier. When omitted, Resonance generates one
# and persists it in the SQLite data volume. Do not reuse another Plex app's ID.
# PLEX_CLIENT_IDENTIFIER=
