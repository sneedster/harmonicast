# ── Server ────────────────────────────────────────────────────────────

# Docker host port. Leave at 3001 unless another service already uses it.
HARMONICAST_PORT=3001

# Published Docker image tag. Pin a tested release in production.
HARMONICAST_IMAGE_TAG=1.0.40

# The public URL where users access Harmonicast (no trailing slash).
# Example: https://harmonicast.mydomain.com or http://192.168.1.50:3001
PUBLIC_URL=http://localhost:3001

# Optional stable Plex client identifier. When omitted, Harmonicast generates one
# and persists it in the SQLite data volume. Do not reuse another Plex app's ID.
# PLEX_CLIENT_IDENTIFIER=

# Optional but required to save plugin API keys/secrets in Harmonicast Settings.
# Generate once with: openssl rand -base64 32
# Keep this value backed up; changing it makes existing saved plugin secrets unreadable.
# HARMONICAST_PLUGIN_SETTINGS_KEY=
